                <mxCell id="18" value="Добавление контрольной суммы&lt;br&gt;&lt;div&gt;к данным&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="790" y="280" width="120" height="60" as="geometry"/>
